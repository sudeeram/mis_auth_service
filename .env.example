# Django
DJANGO_SECRET_KEY=replace-for-local-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# MySQL 8
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mis_auth
MYSQL_USER=mis_auth
MYSQL_PASSWORD=auth-dev-password

# Browser and token endpoints
PLATFORM_PUBLIC_ORIGIN=http://localhost:5173
JWT_ISSUER=http://localhost:5173/api/auth
JWT_PRIVATE_KEY_FILE=dev-certs/jwt-private.pem
JWT_PUBLIC_KEY_FILE=dev-certs/jwt-public.pem
AUTH_COOKIE_SECURE=false

# Entra SAML is optional in the HTTP-only local runserver workflow.
SAML_ENABLED=false
